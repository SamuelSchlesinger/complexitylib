+/-
+Copyright (c) 2026 Samuel Schlesinger. All rights reserved.
+Released under MIT license as described in the file LICENSE.Algebraic.
+Authors: Samuel Schlesinger
+-/
+module
+
+import Cslib.Computability.Circuit.Cost
+
+/-!
+# Weighted costs with free output wires
+
+An unused constant and a binary gate are charged by their operation weights;
+designating an original input as output adds no cost.
+-/
+
+set_option linter.privateModule false
+
+namespace CslibTests.CircuitCost
+
+open Cslib.Circuits
+
+private def signature : Signature where
+  Op := Bool
+  Arity op := if op then 2 else 0
+
+private def circuit : Circuit signature 1 2 1 where
+  program := (Program.empty.gate ⟨false, fun i => Fin.elim0 i⟩).gate
+    ⟨true, fun _ => 0⟩
+  outputs := fun _ => 0
+
+example (cost : OperationCost signature) : circuit.cost cost = cost false + cost true := by
+  simp [Circuit.cost, circuit]
+
+example : circuit.cost (fun op : Bool => if op then 5 else 2) = 7 := rfl
+
+example (cost : OperationCost signature) : (Circuit.id signature 1).cost cost = 0 := rfl
+
+example (circuit : Circuit σ n g m) : circuit.cost OperationCost.unit = g :=
+  circuit.cost_unit
+
+end CslibTests.CircuitCost
